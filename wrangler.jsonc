{
  // LiftLens: static site on Cloudflare Workers (static assets). Videos and training logs stay in the
  // user's browser. The only server-side code is worker/index.js: a 404 guard for /assets/*.
  "name": "app",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // react-router BrowserRouter: unknown paths serve index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*"]
  },
  // v1 created the phone relay Durable Object; v2 deletes it (the relay was removed).
  // Keep both tags so existing deployments migrate cleanly.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "deleted_classes": ["Relay"] }
  ]
}
