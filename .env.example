# Copy to .env (git-ignored) and fill in. Deployment-specific values live here or in the
# environment — never in the code.

# Public URL of your deployment. scripts/deploy.sh bakes it into the local-agent package;
# in local development the agent uses it to reach the phone relay.
LIFTLENS_SITE=https://<worker-name>.<your-subdomain>.workers.dev

# Optional: which Cloudflare account to deploy to when you have several (read by wrangler)
# CLOUDFLARE_ACCOUNT_ID=

# Optional, local development only: relay used by the web app. Put it in web/.env.local (read by Vite).
# VITE_RELAY_ORIGIN=https://<your-site>
