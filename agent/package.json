{
  "name": "@dobbylab/liftlens-agent",
  "version": "0.1.0",
  "description": "LiftLens local coach bridge: lets the LiftLens web app use your own Claude Code / Codex / local models to review training videos (videos and logs never leave your devices)",
  "main": "src/server.mjs",
  "scripts": {
    "start": "node src/cli.mjs",
    "serve": "node src/cli.mjs serve",
    "prepack": "rm -rf coaches && cp -R ../coaches ./coaches",
    "postpack": "rm -rf coaches"
  },
  "keywords": [
    "liftlens",
    "claude-code",
    "fitness",
    "pose",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.166",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.17",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "liftlens-agent": "src/cli.mjs"
  },
  "files": [
    "src",
    "coaches"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobbylabhq/liftlens.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/dobbylabhq/liftlens#readme",
  "publishConfig": {
    "access": "public"
  }
}
